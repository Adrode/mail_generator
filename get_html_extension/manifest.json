{
    "manifest_version": 3,
    "name": "Mail Generator",
    "version": "1.1",
    "description": "Generate a message in Outlook using data from a website's HTML code.",
    "permissions": [
        "tabs",
        "nativeMessaging",
        "notifications"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "mail_generator@example.com",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }  
        }
    },
    "action": {},
    "background": {
        "scripts": ["background.js"]
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}